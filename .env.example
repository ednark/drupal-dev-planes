# drupal-agent-planes server configuration (put real values in the MCP client's
# `env` block for this server, or in .env for `npm run mcp:dev`).

# --- Knowledge plane: compose drupal-dev-mcp as a child MCP server (optional) ---
# Without these, knowledge-plane tools degrade to status "unavailable" and all
# state/verification tools keep working.
DRUPAL_DEV_MCP_COMMAND=node
DRUPAL_DEV_MCP_ARGS=/absolute/path/to/drupal-dev-mcp/packages/server/dist/index.js
DRUPAL_MCP_INDEX_ROOT=/absolute/path/to/drupal-dev-mcp/data/index

# --- State plane: drush-backed (optional) ---
# Without DRUPAL_SITE_ROOT, drush runs against the current working directory.
DRUPAL_SITE_ROOT=/absolute/path/to/drupal-site
DRUSH_BIN=drush

# --- Action gate ---
# drush_dispatch (the only side-effecting tool) stays unavailable unless this
# is explicitly "true" in the server env. Keep it false in unattended clients.
DRUPAL_AGENT_ALLOW_EXEC=false