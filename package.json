{
  "name": "drupal-dev-planes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The working harness for Drupal development agents \u2014 an MCP server with four planes: versioned knowledge, live site state, verified writes, and guarded write tools. Never trust the commit.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/knowledge",
    "packages/state",
    "packages/verify",
    "packages/writes",
    "packages/server"
  ],
  "scripts": {
    "sweep:all": "node sweep/runner.mjs all",
    "sweep:failure-mode": "node sweep/runner.mjs fm",
    "sweep:corpus": "node sweep/runner.mjs corpus",
    "sweep:answerability": "SWEEP_ANSWERABILITY_MODELS=${SWEEP_ANSWERABILITY_MODELS:-llama31-8b-16k} node sweep/runner.mjs corpus",
    "sweep:regression": "node sweep/regression.mjs",
    "sweep:scratch": "node sweep/runner.mjs scratch",
    "sweep:gate": "node sweep/gate.mjs",
    "sweep:report": "node sweep/report.mjs",
    "build": "npm run build -w @drupal-dev-planes/knowledge -w @drupal-dev-planes/state -w @drupal-dev-planes/verify -w @drupal-dev-planes/writes -w @drupal-dev-planes/server",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "mcp:start": "node packages/server/dist/index.js",
    "mcp:dev": "tsx packages/server/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ednark/drupal-dev-planes.git"
  },
  "homepage": "https://github.com/ednark/drupal-dev-planes#readme",
  "bugs": {
    "url": "https://github.com/ednark/drupal-dev-planes/issues"
  }
}
