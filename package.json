{
  "name": "drupal-dev-planes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A unified three-plane MCP interface for Drupal development agents: versioned knowledge, live site state, and verified writes.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/knowledge",
    "packages/state",
    "packages/verify",
    "packages/writes",
    "packages/server"
  ],
  "scripts": {
    "build": "npm run build -w @drupal-dev-planes/knowledge -w @drupal-dev-planes/state -w @drupal-dev-planes/verify -w @drupal-dev-planes/writes -w @drupal-dev-planes/server",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "sweep:all": "node sweep/runner.mjs all",
    "sweep:fm": "node sweep/runner.mjs fm",
    "sweep:corpus": "node sweep/runner.mjs corpus",
    "sweep:b2": "SWEEP_B2_MODELS=${SWEEP_B2_MODELS:-llama31-8b-16k} node sweep/runner.mjs corpus",
    "sweep:regression": "node sweep/regression.mjs",
    "sweep:scratch": "node sweep/runner.mjs scratch",
    "sweep:gate": "node sweep/gate.mjs",
    "sweep:report": "node sweep/report.mjs",
    "mcp:start": "node packages/server/dist/index.js",
    "mcp:dev": "tsx packages/server/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.4"
  }
}